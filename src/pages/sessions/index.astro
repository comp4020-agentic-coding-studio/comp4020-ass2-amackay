---
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import SessionsGrid from "../../components/SessionsGrid.astro";
import { sessionLabels, siteConfig } from "../../site-config";
---

<ContentLayout
  title={sessionLabels.plural}
  description={`The twelve-week teaching schedule: what happens in each ${sessionLabels.singular.toLowerCase()}, what to prepare, and what leaves the room.`}
  {...siteConfig}
>
  <p>
    One lab a week, on Wednesdays, in the room with the tutor. The first two
    install the tools and read small databases; from week 3 each lab ends with
    a theorem to prove in mmj2, and the proof is that week's assessed work.
    Each page says what to have done before you arrive, what happens in the
    room, and what you take away.
  </p>
  <SessionsGrid />
</ContentLayout>
